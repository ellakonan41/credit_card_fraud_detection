# Données (dataset Kaggle volumineux, jamais versionné)
data/*
!data/.gitkeep

# Environnements virtuels
venv/
.venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Variables d'environnement / secrets
.env
*.env.local

# Modèles entraînés (souvent volumineux, à gérer séparément si besoin)
*.pkl
*.joblib
models/*
!models/.gitkeep

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
