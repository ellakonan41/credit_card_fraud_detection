# Données (dataset Kaggle volumineux, jamais versionné)
data/*
!data/.gitkeep

# Environnements virtuels
venv/
.venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Variables d'environnement / secrets
.env
*.env.local

# Modèles : on versionne le modèle de production (~1 Mo, format JSON XGBoost)
# pour que `docker compose up` fonctionne au clonage. Le reste est ignoré
# (pickle volumineux, modèles de test).
*.pkl
*.joblib
models/*
!models/.gitkeep
!models/xgb_fraud_model.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
